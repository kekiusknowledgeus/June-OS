{
  "manifest_version": 3,
  "name": "June Browser Bridge",
  "version": "0.1.0",
  "description": "Authenticated loopback control of your existing browser tabs by June.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"}
}
